# Imagen de produccion (Render). La de desarrollo sigue siendo Dockerfile.

# etapa 1: compilar
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx prisma generate && npm run build

# etapa 2: correr
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma
# DATABASE_URL y JWT_SECRET entran al correr (panel de Render), no al construir
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
