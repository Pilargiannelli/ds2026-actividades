@baseUrl = http://localhost:3000

### Hello
GET {{baseUrl}}/

### Listar libros
GET {{baseUrl}}/api/libros

### Sólo los libros disponibles
GET {{baseUrl}}/api/libros?disponible=true

### Un libro
GET {{baseUrl}}/api/libros/1

### Un libro que no existe → 404
GET {{baseUrl}}/api/libros/999

### Crear un libro
POST {{baseUrl}}/api/libros
Content-Type: application/json

{
  "titulo": "Ficciones",
  "autor": "Jorge Luis Borges",
  "genero": "Cuento",
  "img": "/img/ficciones.webp",
  "precio": 9200,
  "disponible": true
}

### Editar un libro
PUT {{baseUrl}}/api/libros/1
Content-Type: application/json

{
  "titulo": "El arca de Noé",
  "autor": "Beatriz Dourmec y Ayax Barnes",
  "genero": "Infantil",
  "img": "/img/arca.jpg",
  "precio": 9000,
  "disponible": false
}

### Editar un libro que no existe → 404
PUT {{baseUrl}}/api/libros/999
Content-Type: application/json

{
  "titulo": "No existe",
  "autor": "Nadie",
  "genero": "N/A",
  "img": "",
  "precio": 0,
  "disponible": false
}

### Borrar un libro
DELETE {{baseUrl}}/api/libros/2

### Borrar el mismo libro otra vez → 404
DELETE {{baseUrl}}/api/libros/2

### Listar autores
GET {{baseUrl}}/api/autores

### Un autor
GET {{baseUrl}}/api/autores/1

### Un autor que no existe → 404
GET {{baseUrl}}/api/autores/999

### Crear un autor
POST {{baseUrl}}/api/autores
Content-Type: application/json

{
  "nombre": "Jorge Luis Borges",
  "nacionalidad": "Argentina"
}

### Editar un autor
PUT {{baseUrl}}/api/autores/1
Content-Type: application/json

{
  "nombre": "Antoine de Saint-Exupéry",
  "nacionalidad": "Francia"
}

### Borrar un autor
DELETE {{baseUrl}}/api/autores/3

### Borrar el mismo autor otra vez → 404
DELETE {{baseUrl}}/api/autores/3
