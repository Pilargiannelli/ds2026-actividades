generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // sin url: en Prisma 7 va en prisma.config.ts
}

enum Rol {
  ADMIN
  CLIENTE
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique // ← @unique: sin cuentas con el mismo mail
  passwordHash String // ← el NOMBRE avisa qué se guarda acá, nunca la contraseña
  nombre       String
  rol          Rol      @default(CLIENTE) // ← nadie se registra como admin
  creadoEn     DateTime @default(now())
}

model Autor {
  id           Int     @id @default(autoincrement())
  nombre       String  @unique
  nacionalidad String
  libros       Libro[] // lado "muchos": NO crea columna
}

model Libro {
  id         Int         @id @default(autoincrement())
  titulo     String
  precio     Int
  imagen     String
  disponible Boolean     @default(true)
  autorId    Int // la FK: esto SÍ es una columna
  autor      Autor       @relation(fields: [autorId], references: [id], onDelete: Restrict)
  categorias Categoria[] // N:M implícita: Prisma maneja la tabla intermedia
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  libros Libro[]
}
